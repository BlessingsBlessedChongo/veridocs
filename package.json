{
  "name": "veridocs",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "description": "Cryptographic document verification system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "npm run db:generate --workspace=@veridocs/database",
    "db:migrate": "npm run db:migrate --workspace=@veridocs/database",
    "db:seed": "npm run db:seed --workspace=@veridocs/database",
    "db:studio": "npm run db:studio --workspace=@veridocs/database",
    "typecheck": "turbo run typecheck",
    "db:deploy": "npm run db:deploy --workspace=@veridocs/database"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DocumentStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum InstitutionVerificationStatus {
  PENDING
  DOMAIN_VERIFIED
  MANUALLY_VERIFIED
  REJECTED
}

enum InstitutionRole {
  ADMIN
  ISSUER
  AUDITOR
  VIEWER
}

enum InstitutionMemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum KeyPairStatus {
  ACTIVE
  ROTATED
  REVOKED
  COMPROMISED
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique
  emailVerified       Boolean             @default(false)
  fullName            String?
  /// scrypt hash for built-in sign-in (AUTH_PROVIDER=local); null for Supabase users and invited people who have not signed up yet
  passwordHash        String?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdInstitutions Institution[]       @relation("InstitutionCreatedBy")
  memberships         InstitutionMember[] @relation("MembershipUser")
  invitedMembers      InstitutionMember[] @relation("MembershipInvitedBy")
  signedDocuments     Document[]          @relation("DocumentSignedBy")
  auditLogs           AuditLog[]          @relation("AuditActor")
  sessions            Session[]
  authTokens          AuthToken[]
  apiKeysCreated      ApiKey[]            @relation("ApiKeyCreatedBy")

  @@index([email])
}

/// A signed-in device (built-in sign-in). Only a hash of the token is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time links sent by email: verify an address, reset a password.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Machine access for an institution (e.g. a student records system signing certificates).
model ApiKey {
  id              String          @id @default(uuid()) @db.Uuid
  institutionId   String          @db.Uuid
  name            String
  /// First characters of the key, shown so people can tell keys apart
  prefix          String          @db.VarChar(16)
  keyHash         String          @unique @db.VarChar(64)
  role            InstitutionRole @default(ISSUER)
  createdByUserId String          @db.Uuid
  createdAt       DateTime        @default(now())
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id])
  documents       Document[]

  @@index([institutionId])
}

/// Where an institution wants to hear about events (document signed, revoked, verified).
model Webhook {
  id              String            @id @default(uuid()) @db.Uuid
  institutionId   String            @db.Uuid
  url             String
  /// Encrypted with MASTER_ENCRYPTION_KEY; used to sign each delivery (HMAC-SHA256)
  encryptedSecret String            @db.Text
  events          String[]
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([institutionId])
}

model WebhookDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  webhookId  String   @db.Uuid
  event      String
  statusCode Int?
  ok         Boolean
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model Institution {
  id                 String                        @id @default(uuid()) @db.Uuid
  name               String
  emailDomain        String                        @unique
  verificationStatus InstitutionVerificationStatus @default(PENDING)
  createdByUserId    String                        @db.Uuid
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  createdBy          User                          @relation("InstitutionCreatedBy", fields: [createdByUserId], references: [id])
  members            InstitutionMember[]
  documents          Document[]
  keyPairs           KeyPair[]
  auditLogs          AuditLog[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]

  @@index([createdByUserId])
  @@index([emailDomain])
}

model InstitutionMember {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @db.Uuid
  institutionId   String                  @db.Uuid
  role            InstitutionRole
  invitedByUserId String?                 @db.Uuid
  status          InstitutionMemberStatus @default(PENDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  institution     Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  invitedBy       User?                   @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, institutionId])
  @@index([userId])
  @@index([institutionId])
}

model KeyPair {
  id                  String        @id @default(uuid()) @db.Uuid
  institutionId       String        @db.Uuid
  publicKey           String        @db.Text
  encryptedPrivateKey String        @db.Text
  algorithm           String        @default("RSA-2048")
  status              KeyPairStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  rotatedAt           DateTime?
  revokedAt           DateTime?
  institution         Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  documents           Document[]

  @@index([institutionId])
  @@index([status])
}

model Document {
  id               String         @id @default(uuid())
  documentId       String         @unique
  title            String
  description      String?
  /// Who the document is about (e.g. the graduate); shown to whoever verifies it
  recipientName    String?
  recipientEmail   String?
  /// Documents signed together share a batch id
  batchId          String?        @db.Uuid
  fileHash         String         @db.VarChar(64)
  signature        String         @db.Text
  institutionId    String         @db.Uuid
  signedByUserId   String         @db.Uuid
  /// Set when the document was signed through an API key rather than in the dashboard
  apiKeyId         String?        @db.Uuid
  keyPairId        String         @db.Uuid
  institution      Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  signedByUser     User           @relation("DocumentSignedBy", fields: [signedByUserId], references: [id])
  keyPair          KeyPair        @relation(fields: [keyPairId], references: [id])
  apiKey           ApiKey?        @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  qrCodeUrl        String?
  status           DocumentStatus @default(ACTIVE)
  issuedAt         DateTime       @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revocationReason String?
  verifications    Verification[]
  auditLogs        AuditLog[]

  @@index([fileHash])
  @@index([institutionId])
  @@index([signedByUserId])
  @@index([keyPairId])
  @@index([status])
  @@index([batchId])
  @@index([issuedAt])
}

model Verification {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verifiedAt    DateTime @default(now())
  result        String
  /// How it was checked: ID (link or QR), UPLOAD (file sent) or HASH (file checked in the browser)
  method        String   @default("ID")
  ipAddress     String?
  userAgent     String?
  failureReason String?

  @@index([documentId])
  @@index([verifiedAt])
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  action        String
  entityType    String
  entityId      String
  actorUserId   String      @db.Uuid
  institutionId String      @db.Uuid
  documentId    String?
  actor         User        @relation("AuditActor", fields: [actorUserId], references: [id])
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  document      Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  metadata      Json?
  createdAt     DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
  @@index([institutionId])
}

# Runtime database connection
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Generate a 32-byte hexadecimal key for encrypting issuer private keys.
MASTER_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Optional distributed rate limiting
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# Public URLs used by the API and web application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
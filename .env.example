# Local development settings for VeriDocs. Never commit this file.

# Your local Postgres. Replace YOUR_POSTGRES_PASSWORD with the password of the "postgres" user.
# The "veridocs" database is created automatically the first time migrations run.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/veridocs"
DIRECT_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/veridocs"

# Encrypts every institution's private signing key (generated for this laptop; back it up).
MASTER_ENCRYPTION_KEY="replace-with-64-hex-characters (openssl rand -hex 32)"

# Sign-in: "local" (VeriDocs' own accounts, the default) or "supabase".
AUTH_PROVIDER="local"
NEXT_PUBLIC_AUTH_PROVIDER="local"

# Only needed when AUTH_PROVIDER="supabase".
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email (verification, password reset, invitations). Leave SMTP_HOST empty in development:
# emails are then printed in the API terminal instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="VeriDocs <no-reply@veridocs.local>"

# Optional distributed rate limiting
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Production refuses webhooks to private or internal addresses. Set to true only for staging or local tests.
WEBHOOK_ALLOW_PRIVATE_NETWORKS="false"
